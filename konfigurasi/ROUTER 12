IP ADDRESS

add address=10.10.11.1/30 interface=ether1 comment=LINK-R11
add address=10.10.13.1/30 interface=ether2 comment=LINK-R13
add address=192.168.12.20/24 interface=ether3 comment=VLAN20
add address=192.168.12.10/24 interface=ether4 comment=VLAN10
add address=203.0.113.2/30 interface=ether5 comment=ISP
add address=192.168.12.30/24 interface=ether6 comment=VLAN30

DEFAULT ROUTE

ip route
add dst-address=0.0.0.0/0 gateway=203.0.113.1

OSPF

routing ospf instance
add name=ospf1 router-id=12.12.12.12 originate-default=if-installed

routing ospf area
add name=backbone area-id=0.0.0.0 instance=ospf1

routing ospf interface-template
add networks=10.10.11.0/30 area=backbone
add networks=10.10.13.0/30 area=backbone
add networks=192.168.12.10/24 area=backbone
add networks=192.168.12.20/24 area=backbone
add networks=192.168.12.30/24 area=backbone

NAT

ip firewall nat
add chain=srcnat out-interface=ether5 action=masquerade

FIREWALL

ip firewall filter
add chain=input connection-state=established,related action=accept
add chain=input connection-state=invalid action=drop
add chain=input protocol=icmp action=accept
add chain=input protocol=ospf action=accept
add chain=input in-interface=ether3 protocol=udp dst-port=67 action=accept
add chain=input in-interface=ether4 protocol=udp dst-port=67 action=accept
add chain=input in-interface=ether6 protocol=udp dst-port=67 action=accept
add chain=input action=drop comment="Protect Router"
add chain=forward connection-state=established,related action=accept
add chain=forward connection-state=invalid action=drop
add chain=forward action=accept

IP LAN FINAL 

ip address
add address=192.168.22.1/24 interface=ether3 comment=VLAN20
add address=192.168.12.1/24 interface=ether4 comment=VLAN10
add address=192.168.32.1/24 interface=ether6 comment=VLAN30

DHCP FINAL

ip pool
add name=pool12v10 ranges=192.168.12.100-192.168.12.200
add name=pool12v20 ranges=192.168.22.100-192.168.22.200
add name=pool12v30 ranges=192.168.32.100-192.168.32.200

ip dhcp-server
add name=dhcp12v10 interface=ether4 address-pool=pool12v10 disabled=no
add name=dhcp12v20 interface=ether3 address-pool=pool12v20 disabled=no
add name=dhcp12v30 interface=ether6 address-pool=pool12v30 disabled=no

ip dhcp-server network
add address=192.168.12.0/24 gateway=192.168.12.1 dns-server=8.8.8.8
add address=192.168.22.0/24 gateway=192.168.22.1 dns-server=8.8.8.8
add address=192.168.32.0/24 gateway=192.168.32.1 dns-server=8.8.8.8

